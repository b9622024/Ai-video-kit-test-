[
 {
  "line": 1,
  "text": "一樣 60 公斤，",
  "start": 0.6,
  "end": 2.1
 },
 {
  "line": 2,
  "text": "看起來卻可能完全不一樣。",
  "start": 2.5,
  "end": 4.944
 },
 {
  "line": 3,
  "text": "因為體重計量的是總重，",
  "start": 5.344,
  "end": 7.567
 },
 {
  "line": 4,
  "text": "骨頭、水分、肌肉、脂肪，全算在一起。",
  "start": 7.967,
  "end": 10.856
 },
 {
  "line": 5,
  "text": "但肌肉和脂肪的密度不一樣。",
  "start": 11.256,
  "end": 13.922
 },
 {
  "line": 6,
  "text": "同樣 1 公斤，脂肪的體積多了將近兩成。",
  "start": 14.322,
  "end": 17.878
 },
 {
  "line": 7,
  "text": "所以體重一樣，脂肪多，看起來就大一圈。",
  "start": 18.278,
  "end": 21.833
 },
 {
  "line": 8,
  "text": "BMI 也只用身高和體重算，",
  "start": 22.233,
  "end": 24.456
 },
 {
  "line": 9,
  "text": "分不出你重的是肌肉還是脂肪。",
  "start": 24.856,
  "end": 27.744
 },
 {
  "line": 10,
  "text": "外食族今天就能做的：拿捲尺量腰圍。",
  "start": 28.144,
  "end": 31.478
 },
 {
  "line": 11,
  "text": "國健署的標準是：",
  "start": 31.878,
  "end": 33.433
 },
 {
  "line": 12,
  "text": "男生 90、女生 80 公分以上，算腹部肥胖。",
  "start": 33.833,
  "end": 37.611
 },
 {
  "line": 13,
  "text": "與其天天盯體重，不如每月量一次腰圍。",
  "start": 38.011,
  "end": 41.567
 },
 {
  "line": 14,
  "text": "我是崇銘，專業體態管理教練。",
  "start": 41.967,
  "end": 44.633
 },
 {
  "line": 15,
  "text": "想知道你的體態卡在哪裡嗎？",
  "start": 45.033,
  "end": 47.7
 },
 {
  "line": 16,
  "text": "留言「體態」，領取外食族體態自我檢查表！",
  "start": 48.1,
  "end": 51.656
 }
]